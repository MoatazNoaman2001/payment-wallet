# Copy to .env and fill in. .env is git-ignored and never committed.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=

# Where providers should send the customer back to, and where webhooks land.
FUNDING_BASE_URL=

# Payment providers. Leave a block empty and that provider is simply not offered:
# the app reports it as unconfigured instead of failing inside an HTTP call.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=

CRYPTO_API_URL=
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_CONFIRMATIONS=

# Only the offline sandbox provider has a default, because it signs webhooks to itself.
SANDBOX_WEBHOOK_SECRET=
